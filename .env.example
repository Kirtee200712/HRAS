# --- Backend Environment Variables (.env) ---
# Copy these values into your cloud provider's app settings or a local .env file.

# PostgreSQL Connection
DATABASE_URL=jdbc:postgresql://your-cloud-database-url:5432/roomnext
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# Authentication (Create a strong, random 256-bit string)
JWT_SECRET=super_secret_base64_encoded_jwt_key_here_do_not_share

# CORS configuration (Exact URL of the React frontend)
FRONTEND_URL=https://roomnext-production.vercel.app

# --- Frontend Environment Variables (frontend/.env) ---
# Copy these values into Vercel's Environment Variables settings

# Point this to the Spring Boot REST API
VITE_API_URL=https://roomnext-api-production.onrender.com
